# ============================================================
# BIS Intelligent Assistant — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application Server ---
APP_NAME=BIS Intelligent Assistant
APP_VERSION=0.1.0
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_DEBUG=true

# --- Supabase Configuration ---
# For local Supabase CLI development:
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Fallback in-memory database mode for zero-Docker development:
SUPABASE_MOCK=false

# --- AI / RAG Orchestration Service Integration ---
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=your-ai-service-bearer-token
AI_MOCK_MODE=true
AI_TIMEOUT_MS=30000

# --- Security & CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Logging & Observability ---
LOG_LEVEL=INFO
