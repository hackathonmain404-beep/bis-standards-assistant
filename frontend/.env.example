# BIS Intelligent Assistant — Frontend Environment Configuration

# API Gateway base URL
# When using Vite dev proxy, '/api/v1' proxies automatically to http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1

# Set to 'false' to communicate with live Backend API (port 8000)
# Set to 'true' to use in-memory frontend mock data
VITE_USE_MOCK_API=false
