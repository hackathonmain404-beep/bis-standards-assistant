# BIS Intelligent Assistant Frontend Environment Variables

# Backend API base URL (defaults to /api/v1 if unset)
# For remote backend deployment, set this to your backend service URL (e.g. https://api.yourdomain.com/api/v1)
VITE_API_BASE_URL=/api/v1

# Enable/disable client-side mock adapter mode (defaults to true if unset)
# Set to 'false' to connect to live backend API endpoints
VITE_USE_MOCK_API=true
